# ============================================================
# 温蒂翻译助手 - 环境变量模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env      cp .env.example .env
#   2. 把下面的占位值替换成你自己的真实密钥
#   3. .env 已被 .gitignore 忽略，不会被提交到 Git
#
# 所有密钥都只保存在 .env 中，backend/services/ 目录下不再存放明文密钥。
# 未配置的密钥对应的功能会自动降级（翻译→模拟翻译，AI对话→不可用）。
# ============================================================

# 翻译服务优先级：youdao（有道，默认）或 baidu（百度）
TRANSLATION_SERVICE=youdao

# Flask 调试模式：本地开发 true，生产环境 false
# 调试模式会启用 Werkzeug 交互式调试器（可执行任意代码），生产环境务必关闭。
# 注：Docker 部署时 docker-compose.yml 中已固定为 false，不受此处影响。
FLASK_DEBUG=true

# ---------------- 百度翻译 API ----------------
# 获取地址：https://fanyi-api.baidu.com/manage/developer
BAIDU_APPID=your_baidu_appid
BAIDU_SECRET=your_baidu_secret

# ---------------- 有道翻译 API ----------------
# 获取地址：https://ai.youdao.com/console/#/service-singleton/text-translation
YOUDAO_APPKEY=your_youdao_appkey
YOUDAO_SECRET=your_youdao_secret

# ---------------- DeepSeek AI（AI对话助手「小语」）----------------
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key

# ---------------- 百度语音识别 API ----------------
# 获取地址：https://console.bce.baidu.com/ai/#/ai/speech/app/list
BAIDU_SPEECH_APP_ID=your_speech_app_id
BAIDU_SPEECH_API_KEY=your_speech_api_key
BAIDU_SPEECH_SECRET_KEY=your_speech_secret_key

# ---------------- 百度 OCR 文字识别 API ----------------
# 可与语音识别共用同一个应用的 Key；两者都留空则使用语音识别的 Key
BAIDU_OCR_API_KEY=your_ocr_api_key
BAIDU_OCR_SECRET_KEY=your_ocr_secret_key
