# 数据库文件
*.db
*.sqlite
*.sqlite3
Backend/database/wendy_translator.db
Backend/database/*.db
Backend/database/*.sqlite
Backend/database/*.sqlite3
# 根目录数据库文件夹（Docker 使用）
database/*.db
database/*.sqlite
database/*.sqlite3
# 语音合成的磁盘缓存（自动生成的音频，重新朗读时会自动重建）
database/tts_cache/

# 环境变量和配置文件（包含敏感信息）
.env
.env.local
*.key
*.pem

# 本地 HTTPS 自签证书（certs/ 里有 CA 私钥，能签发任意证书，绝不能提交）
# 用 certs/* 而不是 certs/ —— 这样才能把说明文档单独放行，
# 因为 git 无法反悔一个"整个目录被忽略"的规则
certs/*
!certs/README.md

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 日志文件
*.log
logs/

# 临时文件
*.tmp
*.temp
*.bak
*.backup

# 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

